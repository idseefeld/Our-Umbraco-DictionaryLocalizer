@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<SimplePage>
@{
    Layout = "Master.cshtml";

    var formModel = new ContactFormModel();

    var message = TempData["SubmitSuccess"] as bool? ?? false
        ? Umbraco.GetDictionaryValueOrDefault("formSuccessResponse", "Thank You!")
        : null;
}
<div class="container-fluid">

    <div class="standard">

        @Model.BodyText

    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-success" role="alert">
            @message
        </div>
    }
    else
    {

        @if (Model.IsContactForm)
        {
            <div>
                @await Html.PartialAsync("ContactFormView", formModel)
            </div>
        }
    }

</div>