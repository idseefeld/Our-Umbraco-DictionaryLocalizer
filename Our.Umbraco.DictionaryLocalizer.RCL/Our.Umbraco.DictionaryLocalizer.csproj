<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<VersionPrefix>17.9.0</VersionPrefix>
		<AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
		<FileVersion>$(VersionPrefix)</FileVersion>
		<Version>$(VersionPrefix)</Version>
		<ContentTargetFolders>.</ContentTargetFolders>
		<Product>Our.Umbraco.DictionaryLocalizer</Product>
		<PackageId>Our.Umbraco.DictionaryLocalizer</PackageId>
		<Title>Our.Umbraco.DictionaryLocalizer</Title>
		<Description>
			Add Umbraco-Dictionary based localization for e. g. models DataAnnotations.
			Languages icons created by Freepik - Flaticon, https://www.flaticon.com/free-icons/language
		</Description>
		<PackageTags>umbraco-marketplace;localization;DataAnnotations</PackageTags>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageProjectUrl>https://github.com/idseefeld/Our-Umbraco-DictionaryLocalizer</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/idseefeld/Our-Umbraco-DictionaryLocalizer</RepositoryUrl>
		<Authors>Dirk Seefeld</Authors>
		<PackageIcon>languages.png</PackageIcon>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) 2026, Dirk Seefeld</Copyright>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<StaticWebAssetBasePath>\</StaticWebAssetBasePath>
		<RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".pack", ""))</RootNamespace>
	</PropertyGroup>

	<!-- SourceLink -->
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageOutputPath>Z:\nuget.local</PackageOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.8.1,19.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\languages.png" Link="languages.png">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
		<None Include="..\LICENSE.txt" Link="LICENSE.txt">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
		<None Include="..\README.md" Link="README.md">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
		<None Include="..\umbraco-marketplace.json" Link="umbraco-marketplace.json">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>


	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
	</ItemGroup>

	<!-- Synchronize Umbraco Package Version build task from Directory.Build.props to umbraco-package.json -->
	<UsingTask TaskName="SynchronizeUmbracoPackageVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<ManifestPath ParameterType="System.String" Required="true" />
			<Version ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
        if (!Regex.IsMatch(Version, @"^[0-9A-Za-z.+-]+$"))
        {
            Log.LogError("The package version '{0}' cannot be written to the Umbraco manifest.", Version);
            return false;
        }

        var encoding = new UTF8Encoding(false, true);
        var content = encoding.GetString(File.ReadAllBytes(ManifestPath));
        var matches = Regex.Matches(content, @"(?m)^[ \t]*""version""[ \t]*:[ \t]*""(?<value>[^""\r\n\\]*)""[ \t]*,?[ \t]*\r?$");
        if (matches.Count != 1)
        {
            Log.LogError("Expected exactly one version property in the Umbraco manifest '{0}', but found {1}.", ManifestPath, matches.Count);
            return false;
        }

        var value = matches[0].Groups["value"];
        if (value.Value != Version)
        {
            content = content.Remove(value.Index, value.Length).Insert(value.Index, Version);
            File.WriteAllBytes(ManifestPath, encoding.GetBytes(content));
            Log.LogMessage(MessageImportance.High, "Updated Umbraco manifest version to {0}.", Version);
        }
      ]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="SynchronizeUmbracoPackageManifestVersion" BeforeTargets="PrepareForBuild;ResolveStaticWebAssetsInputs;GenerateNuspec" Condition="'$(DesignTimeBuild)' != 'true'">
		<SynchronizeUmbracoPackageVersion ManifestPath="$(MSBuildProjectDirectory)\wwwroot\App_Plugins\$(PackageId)\umbraco-package.json" Version="$(Version)" />
	</Target>

</Project>
